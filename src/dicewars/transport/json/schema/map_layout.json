{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MapLayout",
  "type": "object",
  "additionalProperties": false,
  "required": ["map_name", "dimensions", "territories", "grid_lookup"],
  "properties": {
    "map_name": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "object", 
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "integer", "minimum": 1},
        "y": {"type": "integer", "minimum": 1}
      }
    },
    "territories": {
      "type": "object",
      "propertyNames": {"pattern": "^[0-9]+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "tiles", "adjacencies", "border"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "minLength": 1},
          "tiles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": {"type": "integer", "minimum": 0},
                "y": {"type": "integer", "minimum": 0}
              }
            }
          },
          "adjacencies": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0}
          },
          "border": {
            "type": "array", 
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": {
                    "x": {"type": "integer", "minimum": 0},
                    "y": {"type": "integer", "minimum": 0}
                  }
                },
                "end": {
                  "type": "object", 
                  "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": {
                    "x": {"type": "integer", "minimum": 0},
                    "y": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          }
        }
      }
    },
    "grid_lookup": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {"type": "integer", "minimum": -1}
      }
    }
  }
}